# FOQCAPAY Configuration
# Copy this file to .env and fill in your values

# Application
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# CoinEx API (Get from: https://www.coinex.com/apimanagement)
# For demo mode, these are optional
# For live trading, these are REQUIRED
COINEX_API_KEY=your_api_key_here
COINEX_API_SECRET=your_api_secret_here
COINEX_API_URL=https://api.coinex.com

# Trading Pairs (comma-separated)
TRADING_PAIRS=BTC/USDC,ETH/USDC,LINK/USDC

# Trading Mode
# Options: demo, live
# WARNING: live mode uses real funds!
TRADING_MODE=demo

# Demo Mode Settings
DEMO_STARTING_BALANCE=10000.0
DEMO_SLIPPAGE_PCT=0.1

# Redis (Event Bus)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Database
DATABASE_URL=sqlite+aiosqlite:///./foqcapay.db

# Risk Management Defaults
DEFAULT_STOP_LOSS_PCT=2.0
DEFAULT_TAKE_PROFIT_PCT=4.0
MAX_POSITION_SIZE_PCT=20.0
MAX_CONCURRENT_POSITIONS=5
MAX_DRAWDOWN_PCT=10.0

# Strategy Defaults
DEFAULT_STRATEGY=intraday
ENABLE_SCALPING=true
ENABLE_INTRADAY=true
ENABLE_SWING=true

# Performance
MAX_WORKERS=10
REQUEST_TIMEOUT=30

# Frontend
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
