# FOQCAPAY Trading Bot - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# TRADING CONFIGURATION
# ============================================================================

# Trading mode: "demo" or "live"
# WARNING: Use "demo" for testing! "live" mode trades with real money!
TRADING_MODE=demo

# Trading pairs (comma-separated, no spaces)
TRADING_PAIRS=BTC/USDC,ETH/USDC,LINK/USDC

# ============================================================================
# EXCHANGE API CREDENTIALS (CoinEx)
# ============================================================================

# Get API keys from: https://www.coinex.com/account/api-key
# REQUIRED for live trading mode
# Leave empty for demo mode

COINEX_API_KEY=your_api_key_here
COINEX_API_SECRET=your_api_secret_here

# ============================================================================
# SECURITY
# ============================================================================

# Encryption password for storing API keys securely
# IMPORTANT: Use a strong, unique password!
# This is used to encrypt your API keys in the database
ENCRYPTION_PASSWORD=change_this_to_a_strong_random_password_min_32_chars

# ============================================================================
# RISK MANAGEMENT
# ============================================================================

# Maximum size for a single order (USD)
# Production safeguard: prevents accidental large orders
MAX_POSITION_SIZE=5000

# Maximum daily trading volume (USD)
# Production safeguard: limits total daily exposure
MAX_DAILY_VOLUME=20000

# Maximum portfolio drawdown (percentage)
# Trading pauses if drawdown exceeds this limit
MAX_DRAWDOWN_PCT=10

# Daily loss limit (percentage)
# Trading pauses if daily losses exceed this limit
DAILY_LOSS_LIMIT_PCT=5

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

# Redis host (use "redis" for Docker, "localhost" for local)
REDIS_HOST=redis

# Redis port
REDIS_PORT=6379

# Redis database number
REDIS_DB=0

# ============================================================================
# LOGGING & DEBUGGING
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Debug mode (true/false)
# WARNING: Do not use in production!
DEBUG=false

# ============================================================================
# NOTIFICATIONS (Optional - Sprint 5.2)
# ============================================================================

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=

# Telegram Chat ID (your user ID or group ID)
TELEGRAM_CHAT_ID=

# Email Configuration (for email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Notification preferences
NOTIFY_ON_TRADES=true
NOTIFY_ON_ERRORS=true
NOTIFY_ON_RISK_ALERTS=true

# ============================================================================
# ADVANCED SETTINGS
# ============================================================================

# CORS allowed origins (comma-separated)
# For frontend access
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Database path (relative to backend directory)
DATABASE_PATH=./data/foqcapay.db

# Log file path
LOG_FILE_PATH=./logs/foqcapay.log
